---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
import config from "@/config";

const newsletter = await getEntry("pages", "newsletter");

if (!newsletter) {
  throw new Error(
    "Missing content entry: `newsletter.md` or `newsletter.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(newsletter);
---

<Layout
  title={`${newsletter.data.title} | ${config.site.title}`}
  description={newsletter.data.description}
  ogImage={newsletter.data.ogImage}
  canonicalURL={newsletter.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={newsletter.data.title}>
    <div class="app-prose">
      <Content />
    </div>
    <div class="mt-8 max-w-xl">
      <NewsletterForm />
    </div>
  </Main>

  <Footer />
</Layout>
